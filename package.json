{
  "name": "investing-app",
  "private": true,
  "workspaces": [
    "packages/common/ts",
    "packages/common/ui",
    "apps/*/frontend-web"
  ],
  "scripts": {
    "build:web": "npm run build --workspace=frontend-web",
    "dev:web": "npm run dev --workspace=frontend-web",
    "openapi:bundle": "redocly bundle docs/openapi/openapi.yaml -o docs/openapi.yaml",
    "openapi:lint": "redocly lint docs/openapi/openapi.yaml",
    "openapi:lint:all": "redocly lint docs/openapi/openapi.yaml docs/openapi.yaml apps/portfolio-b/docs/openapi.yaml apps/portfolio-c/docs/openapi.yaml",
    "test": "vitest run",
    "lint": "tools/lint/node_modules/.bin/eslint packages/common/ts packages/common/ui apps/*/frontend-web --max-warnings=0",
    "lint:install": "npm ci --prefix tools/lint"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  },
  "devDependencies": {
    "@redocly/cli": "^2.37.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "jsdom": "^30.1.1",
    "vitest": "^5.0.2"
  }
}
