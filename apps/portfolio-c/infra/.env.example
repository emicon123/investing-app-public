# ── Database ────────────────────────────────────────────────────
POSTGRES_DB=portfolioC
POSTGRES_USER=portfolio_c_user
POSTGRES_PASSWORD=changeme

# ── Backend (Go) + Flyway runner (passed to backend-go-portfolio-c / flyway-portfolio-c) ──
DB_URL=jdbc:postgresql://db-shared:5432/portfolio_c
DB_USERNAME=portfolio_c_user
DB_PASSWORD=changeme

SPRING_PROFILES_ACTIVE=prod

# ── Auth (shared Google OAuth project with investing-app / portfolio-b) ─
# Same GOOGLE_CLIENT_ID as the other two apps — one Google Cloud OAuth client,
# different allowlists per app.
GOOGLE_CLIENT_ID=changeme.apps.googleusercontent.com
ALLOWED_EMAIL_1=changeme@example.com
ALLOWED_EMAIL_2=changeme@example.com
# HMAC-SHA256 secret, >= 32 chars. Generate a fresh one per app — do not reuse
# portfolio-b's JWT_SECRET (rotating one app's secret shouldn't log
# out the other app's sessions).
JWT_SECRET=changeme-generate-a-random-32-plus-char-secret

# ── pgAdmin (dev profile only) — port 5051 ──────────────────────
PGADMIN_DEFAULT_EMAIL=admin@localhost
PGADMIN_DEFAULT_PASSWORD=changeme

# ── Frontend build args ──────────────────────────────────────────
# Same Google OAuth client ID, baked into the Vite bundle at build time.
VITE_GOOGLE_CLIENT_ID=changeme.apps.googleusercontent.com
# Frontend API base URL (app is served under /portfolio-c/ prefix)
VITE_API_BASE_URL=/portfolio-c/api
