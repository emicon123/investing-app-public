# ── Database ────────────────────────────────────────────────────
POSTGRES_DB=portfolioB
POSTGRES_USER=portfolio_b_user
POSTGRES_PASSWORD=changeme

# ── Backend (Go) + Flyway runner (passed to backend-go-portfolio-b / flyway-portfolio-b) ──
DB_URL=jdbc:postgresql://db-shared:5432/portfolio_b
DB_USERNAME=portfolio_b_user
DB_PASSWORD=changeme

SPRING_PROFILES_ACTIVE=prod

# ── pgAdmin (dev profile only) — port 5051 ──────────────────────
PGADMIN_DEFAULT_EMAIL=admin@localhost
PGADMIN_DEFAULT_PASSWORD=changeme

# ── Frontend API base URL (app is served under /portfolio-b/ prefix) ─
VITE_API_BASE_URL=/portfolio-b/api
