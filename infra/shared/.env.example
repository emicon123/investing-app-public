POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme-superuser-password
# Reuse each app's existing DB_PASSWORD (from that app's own infra/.env) here —
# these must match exactly, since each app's DB_URL/DB_PASSWORD will point at
# these same roles on the shared instance.
INVESTING_DB_PASSWORD=changeme
PORTFOLIO_B_DB_PASSWORD=changeme
PORTFOLIO_C_DB_PASSWORD=changeme
