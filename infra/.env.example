# ── Tailscale hostname ──────────────────────────────────────────
# RPi Tailscale hostname: <your-machine>.<your-tailnet>
# Web app URL: https://<your-machine>.<your-tailnet>.ts.net
# API base URL: https://<your-machine>.<your-tailnet>.ts.net/api
TAILSCALE_HOSTNAME=changeme

# ── Database (shared Postgres stack, infra/shared/compose.yml) ──
# Must match INVESTING_DB_PASSWORD in infra/shared/.env exactly — same secret,
# duplicated across two independently-edited files by design (ADR-083 / task 132).
# Rotate both together or the backend will fail to authenticate against db-shared.
DB_URL=jdbc:postgresql://db-shared:5432/investing
DB_USERNAME=investing_user
DB_PASSWORD=changeme

# Profile (dev/prod) read by backend-go
SPRING_PROFILES_ACTIVE=prod

# ── pgAdmin (dev profile only) ──────────────────────────────────
# Bound to 127.0.0.1:5050 — NOT exposed on Tailscale network.
# Access remotely via SSH tunnel:
#   ssh -L 5050:localhost:5050 user@investing-rpi
#   Then open http://localhost:5050 in browser
PGADMIN_DEFAULT_EMAIL=admin@localhost
PGADMIN_DEFAULT_PASSWORD=changeme

# ── Market data ─────────────────────────────────────────────────
MARKET_DATA_PRICE_CACHE_TTL_MINUTES=15

# ── Historia scheduler ──────────────────────────────────────────
# Cron runs at 23:00 Warsaw time (Europe/Warsaw). Zone is set in @Scheduled.
# No env var needed — hardcoded in backend-go/internal/historia/scheduler.go.

# ── Frontend API base URL (used by shared-ts) ───────────────────
VITE_API_BASE_URL=/api

GOOGLE_CLIENT_ID=changeme.apps.googleusercontent.com
ALLOWED_EMAIL_1=changeme@example.com
ALLOWED_EMAIL_2=changeme@example.com

# ── Session JWT secret ───────────────────────────────────────────
# HMAC-SHA256 secret, >= 32 chars. Generate a fresh one per app — do not reuse
# a sibling app's JWT_SECRET (rotating one app's secret shouldn't log out the
# other app's sessions).
JWT_SECRET=changeme-generate-a-random-32-plus-char-secret

# ── Frontend web Google OAuth (baked into Vite bundle at build time) ──────────
VITE_GOOGLE_CLIENT_ID=changeme.apps.googleusercontent.com

# Daily AI asset-news ingest — shared secret for the host cron job
# (infra/news/news-research.sh) to call GET /news/assets and POST /news/ingest.
# Also reused by the bot module's cron scripts (infra/bot/*.sh) via the same
# machine-auth pattern (X-Service-Token) — see BOT_INGEST_TOKEN note below.
NEWS_INGEST_TOKEN=changeme

# Optional alias some infra/bot/*.sh scripts look for first; falls back to
# NEWS_INGEST_TOKEN if unset. There is no separate token validated server-side
# today — set this only if you want a differently-named var in your shell env,
# the value must still equal NEWS_INGEST_TOKEN above.
# BOT_INGEST_TOKEN=changeme

# ── Web Push phone notifications (ADR-108 / task 172; replaces ntfy, ADR-107) ─────
# The backend (backend-go only) sends Web Push itself: the morning news report outcome
# (infra/news/news-research.sh → POST /api/news/notifications) and the Settings page's test
# button. All three vars unset/empty = push disabled: the Settings "Powiadomienia" card is
# hidden and the news job logs "push not configured" and carries on. Setup: infra/news/README.md.
#
# Generate the key pair (prints the two lines below; it never writes a file):
#   cd apps/main/backend-go && go run ./cmd/vapidkeys
# VAPID_PRIVATE_KEY is a secret. Rotating the pair invalidates every subscription — each
# device must re-subscribe (it does so by itself on its next visit to /settings).
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# Contact for the push services. Must start with "mailto:" (or "https:") — push stays disabled
# otherwise. Keep the "mailto:" prefix here: the backend strips it before handing the value to
# the webpush library, which adds it back itself.
# VAPID_SUBJECT=mailto:you@example.com

FRED_API_KEY=changeme

# ── OKX trading API (bot module — task 141) ──────────────────────
# Create the key on OKX with TRADE permission only — withdrawal disabled.
# All three fields below are required together for every signed request.
OKX_API_KEY=changeme
OKX_API_SECRET=changeme
OKX_API_PASSPHRASE=changeme
# EEA accounts must use eea.okx.com — www.okx.com answers 50119 on this key (verified 2026-09-10).
OKX_BASE_URL=https://eea.okx.com
# true = OKX demo/paper trading (same API, zero capital risk) — recommended
# for testing any change to the trading client before flipping to false.
OKX_DEMO_MODE=true

# ── BLS direct CPI actuals (bot module — ADR-093 / task 147) ─────
# Optional: free BLS registration (email only) raises the daily quota from ~25 to ~500 requests.
# Leave empty to run unregistered — the default request caps (app.bot.bls.max-requests-per-*)
# are sized to be safe either way. The feature itself ships OFF (app.bot.bls.enabled=false) — this
# key has no effect until a separate, explicit decision flips that flag.
BLS_API_KEY=
